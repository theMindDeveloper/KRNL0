{
  "appId": "com.theminddevlab.krnl0",
  "productName": "KRNL0",
  "icon": "build/icon.png",
  "directories": {
    "output": "release"
  },
  "files": [
    "out/**/*",
    "bin/**/*",
    "build/icon.*",
    "claude/**/*"
  ],
  "asarUnpack": [
    "claude/**/*"
  ],
  "afterPack": "build/afterPack.js",
  "mac": {
    "target": "dmg"
  },
  "win": {
    "target": "nsis",
    "icon": "build/icon.ico"
  },
  "linux": {
    "target": "AppImage"
  }
}
