{
  "name": "krnl0",
  "version": "0.8.9",
  "description": "krnl0 — voice-driven canvas for personal planning",
  "author": {
    "name": "theMindDeveloper",
    "email": "theminddevlab@gmail.com"
  },
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:shared": "electron-vite dev",
    "build": "electron-vite build",
    "package:win": "npm run build && electron-builder --win --x64 --publish never",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "reset": "node scripts/reset-board.mjs",
    "reset:hard": "node scripts/reset-board.mjs --hard",
    "postinstall": "node scripts/patch-node-pty-spectre.mjs && electron-builder install-app-deps"
  },
  "bin": {
    "krnl": "bin/krnl.js",
    "sys": "bin/sys.js"
  },
  "dependencies": {
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.3.0",
    "@xyflow/react": "^12.10.2",
    "node-pty": "^1.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-resizable-panels": "^4.11.1",
    "zod": "^3.23.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
