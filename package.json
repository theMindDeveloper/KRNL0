{
  "name": "krnl0",
  "version": "0.11.0",
  "description": "krnl0 — voice-driven canvas for personal planning",
  "author": {
    "name": "theMindDeveloper",
    "email": "theminddevlab@gmail.com"
  },
  "license": "MIT",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:shared": "electron-vite dev",
    "seed:preview": "vite-node scripts/seed-observe-preview.ts",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.renderer.json",
    "reset": "node scripts/reset-board.mjs",
    "reset:hard": "node scripts/reset-board.mjs --hard",
    "icons": "electron scripts/generate-icons.mjs",
    "postinstall": "electron-rebuild -f -w node-pty"
  },
  "bin": {
    "krnl": "bin/krnl.js",
    "sys": "bin/sys.js"
  },
  "dependencies": {
    "@fontsource/caveat": "^5.1.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "@fontsource/stardos-stencil": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^5.3.0",
    "@xyflow/react": "^12.10.2",
    "electron-updater": "~6.1.8",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^4.10.38",
    "perfect-freehand": "^1.2.2",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-player": "^2.16.0",
    "react-resizable-panels": "^4.11.1",
    "zod": "^3.23.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.13.0",
    "electron-vite": "^2.3.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
